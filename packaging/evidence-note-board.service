[Unit]
Description=Evidence Note Board local SQLite and D-Bus backend
After=dbus.socket

[Service]
# Wait until the session bus name has been acquired before reporting ready.
Type=dbus
BusName=io.github.mujin0422.EvidenceNoteBoard
ExecStart=%h/.local/bin/evidence-note-boardd
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
UMask=0077

[Install]
# Starts automatically with the user's systemd session (not as root).
WantedBy=default.target
